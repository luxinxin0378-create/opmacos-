#!/bin/sh

# LuCI 默认主题：mac（macOS Liquid Glass）
#
# 文件名用 zzz-0- 前缀：全新文件名在保留配置升级（rootfs_data 保留）
# 后不会被旧固件的 whiteout 隐藏，每次升级后必然重新执行。
# Argon 的「抢默认」脚本已由固件 prepare 侧 files 覆盖为只注册、
# 不设默认的空操作版本，本脚本因此能稳定生效。

uci -q get luci.themes >/dev/null 2>&1 || uci set luci.themes=themes
uci -q set luci.themes.Mac='/luci-static/mac'
uci -q set luci.main.mediaurlbase='/luci-static/mac'
uci -q commit luci

exit 0
